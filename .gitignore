# ============================================================================
# Environment variables (SECURITY CRITICAL)
# ============================================================================
!.env
!.env.*
!.env.example

# Allow environment directory
!_environment/
!_environment/**/

# Ignore real env files
! _environment/.env
! _environment/.env.*
# Allow templates
!_environment/.env.example

